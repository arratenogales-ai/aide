# Aide: copy this file to .env and fill in what you use. Never commit .env.

# Your name: the bot, the panel and the prompts call you by it. Empty: neutral wording.
USER_NAME=

# Telegram bot token (from @BotFather) and your numeric Telegram user id (only that user is served).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Google OAuth client file and the Gmail account you authorize (the program checks it matches).
GOOGLE_CREDENTIALS_PATH=config/credentials.json
GOOGLE_ACCOUNT=

# Local panel.
PANEL_HOST=127.0.0.1
PANEL_PORT=8765
# Optional: your Mac's Tailscale name (x.y.ts.net) to open the panel from your phone. Empty: local only.
PANEL_TAILSCALE=

# Optional: IANA time zone (for example Europe/Madrid); overrides config/settings.yaml.
# TIME_ZONE=

# Claude credential (see "Claude account" in the README). With claude.credential: api_key in
# config/settings.yaml (the default), save your Claude Console API key in the macOS keychain with
#   uv run aide --set-api-key
# If you put it here instead, it is moved to the keychain at startup; you can then delete it.
# The key never reaches the environment of the agent's sessions.
# ANTHROPIC_API_KEY=

# Only with claude.credential: login and the real Chrome turned off, a long-lived token from
# `claude setup-token` can be used instead of /login:
# CLAUDE_CODE_OAUTH_TOKEN=
